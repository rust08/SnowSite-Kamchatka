{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Snow Haul Evidence synthetic parsed envelope v0.1",
  "description": "Envelope only. Individual row validation via $defs.record; runtime authoritative for calendar, receipt chronology, histories and pair semantics. No raw byte validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "source",
    "datasetId",
    "scopeId",
    "periodStart",
    "periodEnd",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": "haul-evidence.synthetic.v0.1"
    },
    "mode": {
      "const": "synthetic"
    },
    "source": {
      "enum": [
        "carrier",
        "receiver"
      ]
    },
    "datasetId": {
      "$ref": "#/$defs/id"
    },
    "scopeId": {
      "$ref": "#/$defs/id"
    },
    "periodStart": {
      "$ref": "#/$defs/timestamp"
    },
    "periodEnd": {
      "$ref": "#/$defs/timestamp"
    },
    "records": {
      "type": "array",
      "maxItems": 5000,
      "items": {}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "allOf": [
        {
          "not": {
            "pattern": "[\\uD800-\\uDFFF]"
          }
        },
        {
          "not": {
            "pattern": "^[\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]|[\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF](?![\\s\\S])"
          }
        }
      ]
    },
    "timestamp": {
      "type": "string",
      "pattern": "^(?!0000)[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z(?![\\s\\S])"
    },
    "quantity": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8})(\\.[0-9]{1,3})?(?![\\s\\S])"
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "$ref": "#/$defs/id"
        },
        "series": {
          "$ref": "#/$defs/id"
        },
        "ticket": {
          "$ref": "#/$defs/id"
        },
        "contract": {
          "$ref": "#/$defs/id"
        },
        "site": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "action": {
          "enum": [
            "issue",
            "correct",
            "cancel"
          ]
        },
        "eventAt": {
          "$ref": "#/$defs/timestamp"
        },
        "receivedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "unit": {
          "const": "m3"
        },
        "basis": {
          "const": "nominal"
        },
        "quantity": {
          "anyOf": [
            {
              "$ref": "#/$defs/quantity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "cancel"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "quantity": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "quantity": {
                "$ref": "#/$defs/quantity"
              }
            }
          }
        }
      ],
      "required": [
        "namespace",
        "series",
        "ticket",
        "contract",
        "site",
        "revision",
        "action",
        "eventAt",
        "receivedAt",
        "unit",
        "basis",
        "quantity"
      ]
    }
  }
}
