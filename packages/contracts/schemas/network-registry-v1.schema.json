{
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "networks"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "networks": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "sha256", "file"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 200},
          "version": {"type": "string", "minLength": 1, "maxLength": 200},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "file": {"type": "string", "minLength": 1, "maxLength": 4096}
        }
      }
    }
  }
}
